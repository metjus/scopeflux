{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scopeflux",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scopeflux",
      "database_id": "abcd9faa-8b51-47fd-b6d7-1f3530dc9843",
      "migrations_dir": "migrations"
    }
  ]
}

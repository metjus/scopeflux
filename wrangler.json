{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scopeflux",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scopeflux",
      "database_id": "bb3cc75f-1041-4833-bee5-23146945300b",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true
}

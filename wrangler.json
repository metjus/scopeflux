{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scopeflux",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "TREND_API_ENABLED": "false"
  }
}

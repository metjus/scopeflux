{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scopeflux",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scopeflux",
      "database_id": "abcd9faa-8b51-47fd-b6d7-1f3530dc9843",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "triggers": {
    "crons": [
      "10 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true
}
